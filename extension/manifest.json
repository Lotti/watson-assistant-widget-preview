{
  "manifest_version": 3,
  "name": "Watson Assistant Widget Preview",
  "description": "Inject Watson Assistant Web Chat integration javascript code inside any website",
  "version": "1.0.0",
  "homepage_url": "https://github.com/lotti/watson-assistant-widget-preview",
  "browser_specific_settings": {
    "gecko": {
      "id": "watson-assistant-widget-preview@dte.addon"
    }
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>", "https://assistant-web.watsonplatform.net/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ],
  "icons": {
    "1024": "icons/icon-1024.png",
    "512": "icons/icon-512.png",
    "96": "icons/icon-96.png",
    "48": "icons/icon-48.png"
  },
  "action": {
    "default_icon": {
      "1024": "icons/icon-1024.png",
      "512": "icons/icon-512.png",
      "96": "icons/icon-96.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Watson Assistant Widget Preview",
    "default_popup": "index.html"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  }
}
